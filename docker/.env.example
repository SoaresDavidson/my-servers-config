# Tailscale auth key. Gere em https://login.tailscale.com/admin/settings/keys
# Recomendado: chave reutilizável, com tag dedicada e expiração definida.
TS_AUTHKEY=tskey-auth-substitua-por-sua-chave

# Usuário e grupo que serão donos dos arquivos de configuração.
PUID=1000
PGID=1000

# Timezone IANA, por exemplo America/Sao_Paulo.
TZ=America/Sao_Paulo

# Nome da rede Docker compartilhada por todas as stacks.
NETWORK_NAME=medianet

# Caminhos no host. Devem ser absolutos.
CONFIG_HOST_PATH=/DATA/AppData/media-stack
# Pai unico de Downloads e media, montado como /data nos containers.
# Precisa conter as subpastas Downloads/ e media/{tv,movies,music,books,audiobooks} no mesmo
# filesystem, senao os *arr copiam em vez de fazer hardlink.
DATA_HOST_PATH=/DATA

# Backup (stack backup). Senha da criptografia GPG dos arquivos enviados ao Google Drive.
# Guarde também FORA do servidor (gerenciador de senhas): sem ela o backup não abre.
BACKUP_PASSPHRASE=troque-por-uma-senha-longa
# Opcionais.
BACKUP_HOST_PATH=/DATA/Backups/media-stack
BACKUP_RETENTION_DAYS=7

# Hermes Agent (stack hermes). Chave usada pelo provedor OpenAI do agente.
HERMES_OPENAI_API_KEY=sk-substitua-pela-sua-chave
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=troque-por-uma-senha

# Homepage (stack homepage). Sufixo MagicDNS do tailnet (tailscale status --json | jq -r .MagicDNSSuffix)
# e IP do servidor na LAN, usados nos links do dashboard.
TS_DOMAIN=tailxxxxxx.ts.net
HOST_LAN_IP=192.168.100.35
# Chaves de API dos widgets. Preencha com scripts/homepage-keys.sh.
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_LIDARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_BOOKSHELF_KEY=
HOMEPAGE_VAR_BAZARR_KEY=
HOMEPAGE_VAR_JELLYSEERR_KEY=
