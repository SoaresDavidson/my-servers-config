# Tailscale auth key. Gere em https://login.tailscale.com/admin/settings/keys
# Recomendado: chave reutilizável, com tag dedicada e expiração definida.
TS_AUTHKEY=tskey-auth-substitua-por-sua-chave

# Usuário e grupo que serão donos dos arquivos de configuração.
PUID=1000
PGID=1000

# Timezone IANA, por exemplo America/Sao_Paulo.
TZ=America/Sao_Paulo

# Nome da rede Docker compartilhada por todas as stacks.
NETWORK_NAME=medianet

# Caminhos no host. Devem ser absolutos.
CONFIG_HOST_PATH=/DATA/AppData/media-stack
# Pai unico de downloads e media, montado como /data nos containers.
# Precisa conter as subpastas downloads/ e media/{tv,movies,music,books,audiobooks} no mesmo
# filesystem, senao os *arr copiam em vez de fazer hardlink.
DATA_HOST_PATH=/DATA/Media
